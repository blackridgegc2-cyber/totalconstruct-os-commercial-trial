function resizeMarkupCanvas(){let c=$('#markupCanvas');if(!c)return;let v=$('#drawingViewer');c.width=Math.max(500,v.clientWidth-36);c.height=Math.max(590,v.clientHeight-36);redrawMarkup()}
function setupMarkupTools(){
 let c=$('#markupCanvas'); if(!c)return; const setTool=t=>{markupTool=t;c.classList.toggle('active',t!=='pointer')};
 $('#toolPointer')?.addEventListener('click',()=>setTool('pointer')); $('#toolHighlight')?.addEventListener('click',()=>setTool('highlight')); $('#toolRect')?.addEventListener('click',()=>setTool('rect')); $('#toolFree')?.addEventListener('click',()=>setTool('free')); $('#toolText')?.addEventListener('click',()=>setTool('text'));
 $('#clearMarkup')?.addEventListener('click',()=>{let f=getCurrentDraw();if(f){f.markup=[];redrawMarkup();$('#markupStatus').textContent='Cleared / unsaved'}});
 $('#saveMarkup')?.addEventListener('click',()=>{let f=getCurrentDraw();if(f){$('#markupStatus').textContent='Saved '+new Date().toLocaleTimeString();save('Saved drawing markup',f.name)}});
 c.onmousedown=e=>{if(markupTool==='pointer')return;let r=c.getBoundingClientRect();startX=e.clientX-r.left;startY=e.clientY-r.top;lastX=startX;lastY=startY;drawing=true;if(markupTool==='text'){let txt=prompt('Markup text');if(txt)pushMark({t:'text',x:startX,y:startY,text:txt});drawing=false}};
 c.onmousemove=e=>{if(!drawing||markupTool!=='free')return;let r=c.getBoundingClientRect(),x=e.clientX-r.left,y=e.clientY-r.top;pushMark({t:'line',x1:lastX,y1:lastY,x2:x,y2:y},false);lastX=x;lastY=y;redrawMarkup()};
 c.onmouseup=e=>{if(!drawing)return;let r=c.getBoundingClientRect(),x=e.clientX-r.left,y=e.clientY-r.top;if(markupTool==='rect'||markupTool==='highlight')pushMark({t:markupTool,x:startX,y:startY,w:x-startX,h:y-startY});drawing=false;redrawMarkup()};
}
function getCurrentDraw(){return (state.drawingFiles||[]).find(x=>x.id===state.currentDrawing)}
function pushMark(m,redraw=true){let f=getCurrentDraw();if(!f)return;f.markup=f.markup||[];f.markup.push(m);if(redraw)redrawMarkup();$('#markupStatus').textContent='Unsaved changes'}
function redrawMarkup(){
 let c=$('#markupCanvas'),f=getCurrentDraw();if(!c||!f)return;let ctx=c.getContext('2d');ctx.clearRect(0,0,c.width,c.height);
 (f.markup||[]).forEach(m=>{if(m.t==='rect'){ctx.strokeStyle='red';ctx.lineWidth=3;ctx.strokeRect(m.x,m.y,m.w,m.h)}if(m.t==='highlight'){ctx.fillStyle='rgba(255,230,0,.28)';ctx.fillRect(m.x,m.y,m.w,m.h)}if(m.t==='line'){ctx.strokeStyle='#ff3b30';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(m.x1,m.y1);ctx.lineTo(m.x2,m.y2);ctx.stroke()}if(m.t==='text'){ctx.fillStyle='red';ctx.font='bold 18px Arial';ctx.fillText(m.text,m.x,m.y)}})
}
