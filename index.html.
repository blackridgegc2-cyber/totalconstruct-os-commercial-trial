function allowed(key){return currentUser?.permissions.includes('all')||currentUser?.permissions.includes(key)}
function visibleProjects(){return state.projects.filter(p=>currentUser?.permissions.includes('all')||currentUser?.projects.includes(p.id))}
function currentProject(){let id=$('#projectSelect')?.value;return state.projects.find(p=>p.id===id)||visibleProjects()[0]}
function gp(p){return p.contract-p.forecastCost}
function comp(p){return p.forecastCost?p.costToDate/p.forecastCost:0}
function earned(p){return p.earnedRevenue||p.contract*comp(p)}
function over(p){return p.billings-earned(p)}
function backlog(p){return Math.max(0,p.contract-p.billings)}
function feeRemaining(p){return p.fee-p.feeEarned}
function statusClass(s){s=(s||'').toLowerCase();if(s.includes('approved')||s.includes('current')||s.includes('complete')||s.includes('active'))return'green';if(s.includes('expired')||s.includes('denied')||s.includes('hold')||s.includes('overdue'))return'red';if(s.includes('pending')||s.includes('soon')||s.includes('suggest')||s.includes('open'))return'amber';return'gray'}
