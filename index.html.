function renderCorrespondence(){let p=currentProject(),im=state.internalMessages.filter(x=>x.project===p.name),em=state.externalMessages.filter(x=>x.project===p.name);$('#correspondence').innerHTML=head('Correspondence',`${p.name} · two deliberately separate communication channels`)+`<div class="two"><div class="card"><h3>🔒 Internal Correspondence</h3><p class="split-note">Company only. Cannot address external users from this channel.</p>${table(['Date','Subject','From','Linked','Status'],im.map(x=>`<tr><td>${x.date}</td><td>${x.subject}</td><td>${x.from}</td><td>${x.linked}</td><td>${x.status}</td></tr>`))}<button class="btn dark section" id="newInternal">New Internal Message</button></div><div class="card"><h3>✉ External Correspondence</h3><p class="split-note">Email-style communication to outside project parties. AI can warn about internal-only data before sending.</p>${table(['Date','Subject','From','To','Linked','Status'],em.map(x=>`<tr><td>${x.date}</td><td>${x.subject}</td><td>${x.from}</td><td>${x.to}</td><td>${x.linked}</td><td>${x.status}</td></tr>`))}<button class="btn primary section" id="newExternal">Compose External Message</button></div></div>`;$('#newInternal').onclick=()=>addMessage('internal');$('#newExternal').onclick=()=>addMessage('external')}
function renderDaily(){let p=currentProject(),rows=state.daily.filter(d=>d.project===p.name);$('#daily').innerHTML=head('Daily Reports / Weather',`${p.name} · weather auto-fill + schedule activity progress`, `<button class="btn primary">+ Daily Report</button>`)+`<div class="card">${table(['Date','Weather','Rain','Workers','Activity','Schedule Activity','Planned','Actual','Issue'],rows.map(d=>`<tr><td>${d.date}</td><td>${d.weather}</td><td>${d.rain}</td><td>${d.workers}</td><td>${d.activity}</td><td>${d.scheduleActivity}</td><td>${d.planned}%</td><td>${d.actual}%</td><td>${d.issue}</td></tr>`))}</div><div class="callout section">Production version: current weather auto-fills from project location and is preserved with the finalized daily report. PM/Super approval controls whether field progress updates the official schedule.</div>`}
function renderTM(){let p=currentProject(),rows=state.tm.filter(x=>x.project===p.name);$('#tm').innerHTML=head('T&M Tickets',`${p.name} · labor, material, equipment, photos and signature → potential change`, `<button class="btn primary">+ T&M Ticket</button>`)+`<div class="card">${table(['Ticket','Date','Description','Labor','Material','Equipment','Total','Status'],rows.map(x=>`<tr><td>${x.id}</td><td>${x.date}</td><td>${x.description}</td><td>${money(x.labor)}</td><td>${money(x.material)}</td><td>${money(x.equipment)}</td><td>${money(x.labor+x.material+x.equipment)}</td><td>${x.status}</td></tr>`))}</div>`}
function renderProcurement(){let p=currentProject(),rows=state.procurement.filter(x=>x.project===p.name);$('#procurement').innerHTML=head('Procurement / Material Tracking',`${p.name} · approved → released → fabrication → shipped → delivered → installed`)+`<div class="card">${table(['Item','Vendor/Sub','Status','Required On Site','Lead','Linked Activity'],rows.map(x=>`<tr><td>${x.item}</td><td>${x.sub}</td><td>${x.status}</td><td>${x.required}</td><td>${x.lead}</td><td>${x.activity}</td></tr>`))}</div>`}
function renderQuality(){let p=currentProject(),rows=state.quality.filter(x=>x.project===p.name);$('#quality').innerHTML=head('Quality / Action Plans / ITPs',`${p.name} · inspections, observations, preparatory meetings and hold points`, `<button class="btn primary">+ Action Plan</button>`)+`<div class="card">${table(['ID','Action Plan / ITP','Steps','Complete','Status'],rows.map(x=>`<tr><td>${x.id}</td><td>${x.title}</td><td>${x.steps}</td><td>${x.complete}</td><td>${x.status}</td></tr>`))}</div><div class="callout section">Example: Pre-Pour Concrete → Forms → Rebar → embeds/MEP → testing agency → AHJ → release to pour, with required signatures and attachments.</div>`}
function renderSafety(){let p=currentProject(),inc=state.incidents.filter(i=>i.project===p.name),tb=state.toolbox.filter(t=>t.project===p.name);$('#safety').innerHTML=head('Safety / OSHA / Toolbox',`${p.name} · incidents, OSHA 300/301/300A, corrective actions and activity-driven talks`, `<button class="btn">OSHA Reports</button><button class="btn primary">+ Incident / Near Miss</button>`)+`<div class="grid">${kpi('Recordable Cases',inc.filter(i=>i.recordable==='Yes').length,'Current project')}${kpi('Near Misses',inc.filter(i=>i.type==='Near Miss').length,'Current project')}${kpi('Corrective Actions',inc.filter(i=>i.status.includes('Open')).length,'Open')}${kpi('Toolbox Talks',tb.length,'Daily + weekly')}</div><div class="two section"><div class="card"><h3>Toolbox Meetings</h3>${table(['Date','Type','Topic','Attendees','Status'],tb.map(t=>`<tr><td>${t.date}</td><td>${t.type}</td><td>${t.topic}</td><td>${t.attendees}</td><td><span class="status ${statusClass(t.status)}">${t.status}</span></td></tr>`))}</div><div class="ai-panel"><h3>AI Safety Assistant</h3><div class="ai-item"><b>Upcoming work:</b> reads schedule and daily activities.</div><div class="ai-item"><b>Toolbox:</b> suggests relevant talking points from the toolbox database.</div><div class="ai-item"><b>Incident:</b> can suggest corrective topics and missing incident data.</div><div class="ai-item"><b>OSHA:</b> potential recordability is flagged for authorized review, not decided autonomously.</div></div></div>`}
function renderEquipment(){let rows=state.equipment.filter(e=>e.project===currentProject().name||allowed('all'));$('#equipment').innerHTML=head('Equipment / Fleet','Company/project equipment, utilization, fuel, maintenance and QR records', `<button class="btn primary">+ Equipment</button>`)+`<div class="card">${table(['ID','Equipment','Type','Ownership','Assigned','Project','Internal Rate','Next Service','Status'],rows.map(e=>`<tr><td>${e.id}</td><td>${e.name}</td><td>${e.type}</td><td>${e.ownership}</td><td>${e.assigned}</td><td>${e.project}</td><td>${money(e.rate)}</td><td>${e.nextService}</td><td>${e.status}</td></tr>`))}</div>`}
function renderCloseout(){let p=currentProject();$('#closeout').innerHTML=head('Closeout',`${p.name} · requirements identified early and assembled continuously`)+`<div class="grid">${kpi('Readiness','35%','Example current readiness')}${kpi('Warranty Records',state.warranties.filter(w=>w.project===p.name).length,'AI indexed')}${kpi('Required Items','26','Template / contract derived')}${kpi('Missing Items','17','Current placeholder')}</div><div class="two section"><div class="card"><h3>Closeout Checklist</h3>${table(['Requirement','Source','Responsible','Status'],['<tr><td>Certificate of Occupancy</td><td>AHJ / Contract</td><td>PM</td><td><span class="status amber">Future</span></td></tr>','<tr><td>Record Drawings / As-Builts</td><td>Closeout Requirements</td><td>Subs</td><td><span class="status amber">Open</span></td></tr>','<tr><td>O&M Manuals</td><td>Specs</td><td>Subs</td><td><span class="status amber">Open</span></td></tr>','<tr><td>Final Warranties</td><td>Specs / Contracts</td><td>PM</td><td><span class="status amber">Open</span></td></tr>'])}</div><div class="ai-panel"><h3>AI Closeout Assembly</h3><div class="ai-item">Finds related documents as they arrive.</div><div class="ai-item">Indexes by CSI / system / asset.</div><div class="ai-item">Builds TOC and bookmarked delivery package.</div><div class="ai-item">Tracks missing requirements continuously.</div></div></div>`}
function renderBidders(){let rows=state.bidders;$('#bidders').innerHTML=head('Bidders / Subcontractor Scorecards','Qualification, bid history and performance intelligence')+`<div class="card">${table(['Company','Trade','Region','Safety','Quality','Schedule','Billing','Score'],rows.map(x=>`<tr><td>${x.company}</td><td>${x.trade}</td><td>${x.region}</td><td>${x.safety}</td><td>${x.quality}</td><td>${x.schedule}</td><td>${x.billing}</td><td><b>${x.score}</b></td></tr>`))}</div>`}
function renderReports(){let p=currentProject();$('#reports').innerHTML=head('Reports / Analytics','Custom report builder + portfolio analytics')+`<div class="grid3"><div class="card"><h3>Financial</h3><p class="split-note">WIP, contract status, budget, commitments, forecast, fee, OH recovery, AR/AP and cash flow.</p></div><div class="card"><h3>Operations</h3><p class="split-note">Schedule, RFIs, submittals, procurement, daily reports, manpower, productivity, safety and quality.</p></div><div class="card"><h3>Portfolio</h3><p class="split-note">Slice performance by PM, Super, client, project type, region, contract type, estimator, year and CSI division.</p></div></div><div class="callout section">Production report builder will allow field selection, filters, grouping, formulas, saved layouts, scheduled delivery and role-based visibility.</div>`}
function renderAudit(){if(!allowed('all')){$('#audit').innerHTML=head('Audit / Versions','Restricted')+'<div class="card">Administrator access required.</div>';return}$('#audit').innerHTML=head('Audit / Versions','Immutable history across financial, schedule, approval, document and permission changes')+`<div class="card">${table(['Date / Time','User','Action','Record','Old','New'],state.audit.slice(0,50).map(a=>`<tr><td>${a.date}</td><td>${a.user}</td><td>${a.action}</td><td>${a.record}</td><td>${a.old}</td><td>${a.new}</td></tr>`))}</div>`}
function renderIntegrations(){$('#integrations').innerHTML=head('Integrations','Two-way accounting + scheduling + email + bank / card + API architecture')+`<div class="grid3"><div class="card"><h3>QuickBooks / Sage / ERP</h3><p class="split-note">Bi-directional vendor, AP, payment, AR and financial mapping with external IDs, source-of-truth rules, conflict review and duplicate protection.</p><span class="status amber">Backend connector required</span></div><div class="card"><h3>P6 / Microsoft Project</h3><p class="split-note">Schedule import/export with activity ID, WBS, logic, calendar, float, percent complete, baselines and milestones.</p><span class="status amber">Backend connector required</span></div><div class="card"><h3>Email / Banking / API</h3><p class="split-note">External correspondence, incoming replies, bank/credit-card feeds and customer API/webhooks.</p><span class="status amber">Backend connector required</span></div></div>`}
function renderSettings(){$('#settings').innerHTML=head('Company Settings','Subscription-ready tenant configuration')+`<div class="grid3"><div class="card"><h3>Branding</h3><p class="split-note">Company logo, color palette, report headers, correspondence signatures and app theme.</p></div><div class="card"><h3>Financial / CSI</h3><p class="split-note">Full CSI library, company cost codes, SUB/GR/OHP classifications, fee methodology, OH allocation and fiscal settings.</p></div><div class="card"><h3>Workflow / Security</h3><p class="split-note">Project statuses, roles, field-level permissions, approval thresholds, templates, safety cadence and closeout requirements.</p></div></div>`}
function addProject(){let name=prompt('Project / opportunity name');if(!name)return;let id='p'+Date.now();state.projects.push({id,job:'TBD',name,client:'TBD',status:'Estimating',prob:25,contract:+(prompt('Estimated value')||0),originalContract:0,estimatedCost:0,forecastCost:0,costToDate:0,billings:0,earnedRevenue:0,fee:0,feeEarned:0,feeBilled:0,feeCollected:0,ohRecovery:0,start:'',end:'',pm:'TBD',super:'TBD',contractType:'TBD',region:'TBD',city:'TBD',estValue:0,subValue:0,consultantFee:0,taxWithhold:0});currentUser.projects.push(id);save('Created project/opportunity',name);syncProjectSelect()}
function addEmployee(){let name=prompt('Employee name');if(!name)return;state.employees.push({id:'e'+Date.now(),name,position:prompt('Position')||'',salary:+(prompt('Annual salary / annualized rate')||0),burden:+(prompt('Payroll burden %')||0),truckAllowance:+(prompt('Monthly truck allowance')||0),assigned:'Unassigned',status:'Active'});save('Added employee',name)}
function addTime(){let employee=currentUser.name,date=prompt('Date (YYYY-MM-DD)',new Date().toISOString().slice(0,10))||'',hours=+(prompt('Hours')||0),category=prompt('Category: Project / Overhead / Estimating / Business Development / Marketing / Training / PTO')||'Project',project=prompt('Project / Corporate',currentProject()?.name||'Corporate')||'',costCode=prompt('Cost code / activity')||'',miles=+(prompt('Mileage')||0),fuel=+(prompt('Fuel $')||0),notes=prompt('Notes')||'';state.time.push({employee,date,hours,category,project,costCode,miles,fuel,notes});save('Added time entry',employee)}
function addUser(){let name=prompt('Employee / user name');if(!name)return;let role=prompt('Role','Project Manager')||'Employee';state.users.push({id:'u'+Date.now(),name,initials:name.split(' ').map(x=>x[0]).join('').slice(0,2).toUpperCase(),role,projects:[],permissions:['project']});save('Invited user',name)}
function addRfi(){let p=currentProject(),subject=prompt('RFI subject');if(!subject)return;state.rfis.push({project:p.name,id:'RFI-'+String(state.rfis.filter(r=>r.project===p.name).length+1).padStart(3,'0'),subject,bic:prompt('Ball in court','Architect')||'',due:prompt('Due date','')||'',activity:'AI Suggested / Pending',float:0,delay:0,tie:'AI Suggested',status:'Open'});save('Created RFI',subject)}
function addSub(){let p=currentProject(),desc=prompt('Submittal description');if(!desc)return;state.submittals.push({project:p.name,id:'SUB-'+String(state.submittals.filter(r=>r.project===p.name).length+1).padStart(3,'0'),spec:prompt('CSI / Spec section')||'',desc,sub:prompt('Subcontractor')||'',bic:'GC',ros:'',lead:'',activity:'AI Suggested / Pending',exposure:0,tie:'AI Suggested',status:'Planned'});save('Created submittal',desc)}
function addTask(){let p=currentProject(),task=prompt('Task');if(!task)return;state.tasks.push({project:p.name,id:'T-'+String(state.tasks.length+1).padStart(3,'0'),source:'Manual',task,owner:prompt('Owner',currentUser.name)||currentUser.name,due:prompt('Due date','')||'',status:'Open'});save('Created task',task)}
function addMessage(type){let p=currentProject(),subject=prompt('Subject');if(!subject)return;if(type==='internal')state.internalMessages.unshift({project:p.name,date:new Date().toISOString().slice(0,10),subject,from:currentUser.name,visibility:'Company Only',linked:'Manual',status:'Open'});else state.externalMessages.unshift({project:p.name,date:new Date().toISOString().slice(0,10),subject,from:currentUser.name,to:prompt('To / recipient')||'External',linked:'Manual',status:'Draft'});save(type==='internal'?'Created internal correspondence':'Created external correspondence',subject)}
function publishSchedule(){let n=state.schedule.versions.length+1;state.schedule.versions.push({id:n,label:'Update '+String(n-1).padStart(2,'0'),date:new Date().toISOString().slice(0,10)});save('Published schedule version',currentProject().name)}
function finalizePA(p,pa){if(!confirm(`Finalize Pay App #${pa.number}? Current values will roll forward and become prior-period values.`))return;let current=pa.rows.reduce((a,x)=>a+x.current+x.stored,0);pa.prior+=current;pa.rows.forEach(x=>{x.prev+=x.current+x.stored;x.current=0;x.stored=0});p.billings=pa.prior;pa.number+=1;save('Finalized pay application',p.name)}
function exportWip(){let ps=visibleProjects().filter(p=>/Awarded|Active|Preconstruction/.test(p.status)),headers=['Job','Project','Original Contract','Approved COs','Current Contract','Original Est Cost','Forecast Cost','Est GP','GP %','Cost to Date','Cost % Complete','Earned Revenue','Billings','Over Under','Backlog','Total Fee','Fee Earned','Fee Remaining','OH Recovery'];let lines=[headers.join(',')].concat(ps.map(p=>[p.job,p.name,p.originalContract,p.contract-p.originalContract,p.contract,p.estimatedCost,p.forecastCost,gp(p),gp(p)/p.contract,p.costToDate,comp(p),earned(p),p.billings,over(p),backlog(p),p.fee,p.feeEarned,feeRemaining(p),p.ohRecovery].map(v=>`"${v}"`).join(',')));download('TotalConstruct_WIP.csv',lines.join('\n'),'text/csv')}
function download(name,text,type){let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([text],{type}));a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),100)}
function syncProjectSelect(){let ps=visibleProjects();$('#projectSelect').innerHTML=ps.map(p=>`<option value="${p.id}">${p.name}</option>`).join('');$('#projectSelect').onchange=()=>{renderNav();renderPage(currentPage);refreshBanner()}}
function aiReply(q){let p=currentProject(),l=q.toLowerCase();if(l.includes('fee')){if(!allowed('all')&&!allowed('financial_project'))return 'Fee information is restricted for your current role.';let ps=visibleProjects();return `Visible projects carry ${money(ps.reduce((a,x)=>a+x.fee,0))} of total fee, ${money(ps.reduce((a,x)=>a+x.feeEarned,0))} earned, and ${money(ps.reduce((a,x)=>a+feeRemaining(x),0))} remaining to earn.`}if(l.includes('overhead')||/\boh\b/.test(l)){if(!allowed('all'))return 'Corporate overhead information is restricted for your current role.';let total=state.overhead.reduce((a,x)=>a+x.actual,0);return `Current modeled corporate overhead is ${money(total)} with ${money(state.company.ohRecovered)} recovered. The modeled unrecovered amount is ${money(Math.max(0,total-state.company.ohRecovered))}.`}if(l.includes('access')||l.includes('projects can i'))return `You currently have access to ${visibleProjects().map(x=>x.name).join(', ')}.`;if(l.includes('warranty'))return `${p.name} has ${state.warranties.filter(x=>x.project===p.name).length} indexed warranty/asset records in this build.`;if(l.includes('insurance'))return `${p.name} has ${state.insurance.filter(x=>x.project===p.name).length} GC/project insurance records and ${state.contracts.filter(x=>x.project===p.name).length} subcontract insurance/compliance records.`;if(l.includes('rfi'))return `${p.name} has ${state.rfis.filter(x=>x.project===p.name).length} RFI record(s).`;if(l.includes('submittal'))return `${p.name} has ${state.submittals.filter(x=>x.project===p.name).length} submittal record(s).`;return `I am scoped to ${p?.name||'Corporate'} and the ${currentPage} screen. In the production backend I will search permitted project/company records and documents, propose actions, and require approval where the action changes records, sends communications, or affects money.`}
function showAI(){let p=currentProject();$('#aiContext').textContent=`Context: ${p?.name||'Corporate'} · ${currentPage} · ${currentUser.role}`;$('#aiModal').classList.remove('hidden');$('#aiInput').focus()}
function sendAI(){let q=$('#aiInput').value.trim();if(!q)return;$('#chat').innerHTML+=`<div class="bubble user">${q}</div><div class="bubble ai">${aiReply(q)}</div>`;$('#aiInput').value='';$('#chat').scrollTop=$('#chat').scrollHeight}

function globalCreate(){
 let choice=prompt('Create what?\n1 RFI\n2 Submittal\n3 Cost Line\n4 Daily Report\n5 Task\n6 Internal Message\n7 External Message\n8 Upload Drawings\n9 T&M Ticket\n10 Meeting\n11 Compliance Requirement\n12 Subcontractor','1');
 if(choice==='1'){openPage('rfis');setTimeout(addRfi,50)}
 if(choice==='2'){openPage('submittals');setTimeout(addSub,50)}
 if(choice==='3'){openPage('financials');setTimeout(()=>$('#addCostLine')?.click(),50)}
 if(choice==='4'){openPage('daily');alert('Daily Report form workflow is partially modeled in this trial.')}
 if(choice==='5'){openPage('tasks');setTimeout(addTask,50)}
 if(choice==='6'){openPage('correspondence');setTimeout(()=>addMessage('internal'),50)}
 if(choice==='7'){openPage('correspondence');setTimeout(()=>addMessage('external'),50)}
 if(choice==='8'){openPage('drawings');setTimeout(()=>$('#drawInput')?.click(),100)}
 if(choice==='9'){openPage('tm');alert('T&M create workflow is next-pass functional work.')}
 if(choice==='10'){openPage('meetings');alert('Meeting create workflow is next-pass functional work.')} if(choice==='11'){openPage('compliance');setTimeout(()=>$('#addCompliance')?.click(),50)} if(choice==='12'){openPage('subcontractors');setTimeout(()=>$('#addSubcontractor')?.click(),50)}
}
$('#globalCreate')?.addEventListener('click',globalCreate);
$$('[data-jump]').forEach(a=>a.onclick=()=>openPage(a.dataset.jump));
function refreshBanner(){
 let p=currentProject();if(!p)return;$('#bannerTitle').textContent=p.name;$('#bannerMeta').textContent=`${p.job} · ${p.status} · PM: ${p.pm} · Super: ${p.super}`;
 let img=state.projectImages?.[p.id],old=$('#projectBanner img');if(old)old.remove();if(img){let im=document.createElement('img');im.src=img;$('#projectBanner').prepend(im)}
}
$('#bannerImageBtn').onclick=()=>$('#bannerImageInput').click();
$('#bannerImageInput').onchange=e=>{let f=e.target.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{state.projectImages=state.projectImages||{};state.projectImages[currentProject().id]=r.result;save('Updated project banner image',currentProject().name);refreshBanner()};r.readAsDataURL(f)};

$('#askAI').onclick=showAI;$('#closeAI').onclick=()=>$('#aiModal').classList.add('hidden');$('#sendAI').onclick=sendAI;$('#aiInput').onkeydown=e=>{if(e.key==='Enter')sendAI()};
$('#demoUser').innerHTML=state.users.map(u=>`<option value="${u.id}">${u.name} — ${u.role}</option>`).join('');
$('#loginBtn').onclick=()=>{currentUser=state.users.find(u=>u.id===$('#demoUser').value);$('#login').classList.add('hidden');$('#app').classList.remove('hidden');$('#userAvatar').textContent=currentUser.initials;syncProjectSelect();renderAll();refreshBanner()};
$('#globalSearch').oninput=e=>{let q=e.target.value.toLowerCase();if(q.length<2)return;e.target.title=`Search is modeled in this functional front end. Production backend will query permitted documents and records for "${q}".`}

</script>
