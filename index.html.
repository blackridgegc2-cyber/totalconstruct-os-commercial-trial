(function migrateTrialState(){
  const clone=v=>JSON.parse(JSON.stringify(v));
  for(const [k,v] of Object.entries(seed)){
    if(state[k]===undefined||state[k]===null) state[k]=clone(v);
  }
  // Merge newly introduced demo collections into older saved browser states without erasing user-entered data.
  ['subcontractorProfiles','preconstruction','compliance','projectStatus'].forEach(k=>{
    if(!Array.isArray(state[k])) state[k]=clone(seed[k]||[]);
    if(state[k].length===0) state[k]=clone(seed[k]||[]);
  });
  if(!state.schedule||!Array.isArray(state.schedule.activities)||!Array.isArray(state.schedule.versions)) state.schedule=clone(seed.schedule);
  if(!state.payapps) state.payapps=clone(seed.payapps);
  if(!Array.isArray(state.audit)) state.audit=[];
  try{localStorage.setItem('totalconstruct_commercial_v2',JSON.stringify(state));}catch(e){console.warn('Trial storage unavailable',e)}
})();
