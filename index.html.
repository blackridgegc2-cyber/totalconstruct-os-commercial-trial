function classifyDrawing(name){
 let n=name.toUpperCase();
 if(/(^|[^A-Z])A[-_ ]?\d|ARCH|A\d{2,}/.test(n))return 'Architectural';
 if(/(^|[^A-Z])S[-_ ]?\d|STRUCT/.test(n))return 'Structural';
 if(/(^|[^A-Z])C[-_ ]?\d|CIVIL|SITE|GRADING|UTILITY/.test(n))return 'Civil';
 if(/(^|[^A-Z])M[-_ ]?\d|MECH|HVAC/.test(n))return 'Mechanical';
 if(/(^|[^A-Z])P[-_ ]?\d|PLUMB/.test(n))return 'Plumbing';
 if(/(^|[^A-Z])E[-_ ]?\d|ELECT|LIGHT|POWER/.test(n))return 'Electrical';
 if(/FIRE|FP[-_ ]?\d|SPRINKLER/.test(n))return 'Fire Protection';
 if(/LAND|L[-_ ]?\d/.test(n))return 'Landscape';
 if(/G[-_ ]?\d|COVER|GENERAL/.test(n))return 'General';
 return 'Other / Review';
}
